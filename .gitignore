# Build output of the DU-LuaC verification projects (docs/verification/luac/run.sh)
docs/verification/luac/*/out/
# Code-completion files DU-LuaC adds to those projects on build
docs/verification/luac/*/util/
docs/verification/luac/*/emmy.config.json
docs/verification/luac/*/.gitignore
# Probe kit results
spikes/results/
# Python environments and caches
.venv/
__pycache__/
.pytest_cache/
.ruff_cache/
# Lua test dependencies fetched by lua/tools/deps.sh
lua/.deps/
